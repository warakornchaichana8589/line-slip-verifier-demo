# Server Configuration
PORT=3000

# LINE Messaging API Credentials (ฟรีจาก https://developers.line.biz)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Slip Verification API (เช่น SlipOK หรือ EasySlip API)
# SlipOK ให้ทดลองฟรี / เติมเงินเริ่มต้นเพียง 100-200 บาท
SLIPOK_BRANCH_ID=your_branch_id_here
SLIPOK_API_KEY=your_slipok_api_key_here

# Google Sheets Logging (บันทึกยอดขายอัตโนมัติ)
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin Notification (Webhook URL สำหรับแจ้งเตือนแอดมินทาง LINE หรือ Discord)
ADMIN_DISCORD_WEBHOOK_URL=
